<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: lightgray;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="simulation.Controller.PrimaryController">
    <left>
        <VBox alignment="TOP_CENTER" maxHeight="-Infinity" prefHeight="80.0" prefWidth="120.0" spacing="10.0" style="-fx-background-color: white;">
            <children>
                <TextField fx:id="widthWorldMapField" promptText="Ширина">
               <VBox.margin>
                  <Insets left="5.0" right="5.0" />
               </VBox.margin></TextField>
            <TextField fx:id="heightWorldMapField" promptText="Высота">
               <VBox.margin>
                  <Insets left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
                <Button fx:id="createWorldMapButton" mnemonicParsing="false" onAction="#createWorldMap" text="Создать Мир">
               <VBox.margin>
                  <Insets />
               </VBox.margin></Button>
            <Label text="Скорость">
               <font>
                  <Font size="11.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="-10.0" top="5.0" />
               </VBox.margin>
            </Label>
            <Slider fx:id="speedSimulationSlider" max="2.0" min="0.1" prefWidth="0.0" showTickLabels="true" value="1.0">
               <VBox.margin>
                  <Insets left="5.0" right="5.0" />
               </VBox.margin>
            </Slider>
            <Button fx:id="startSimulationButton" mnemonicParsing="false" onAction="#startSimulation" text="Старт" />
            <Button fx:id="stopSimulationButton" mnemonicParsing="false" onAction="#stopSimulation" text="Стоп">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Button>
            <Button fx:id="clearWorldMapButton" mnemonicParsing="false" onAction="#clearWorldMap" text="Очистить поле" />
            </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" top="10.0" />
         </BorderPane.margin>
        </VBox>
    </left>
   <center>
      <Canvas fx:id="canvas" height="600.0" style="-fx-background-color: red;" width="800.0" BorderPane.alignment="TOP_LEFT">
         <BorderPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </BorderPane.margin></Canvas>
   </center>
</BorderPane>
